"/**
 * Brand ramp — generated from brandRoles.primary for utilities (bg-brand-*).
 * Designers edit roles in the theme builder, not individual steps.
 *
 * Neutrals: neutral.css · Semantics: brand-semantic.css
 */
:root {
  --brand-50: #f3f2f5;
  --brand-100: #e7e5eb;
  --brand-200: #cfcbd6;
  --brand-300: #b5aec0;
  --brand-400: #948aa4;
  --brand-500: #7c708f;
